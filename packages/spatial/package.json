{
  "name": "@found-in-space/spatial",
  "version": "0.3.0-alpha.0",
  "description": "Dependency-free coordinates, pose, route, and navigation helpers for Found in Space experiences",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/skykit",
    "directory": "packages/spatial"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "!src/**/__tests__/**",
    "README.md",
    "api-contract.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  }
}
