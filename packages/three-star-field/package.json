{
  "name": "@found-in-space/three-star-field",
  "version": "0.3.0-alpha.1",
  "description": "Three.js star field renderer for Found in Space star cells",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/skykit",
    "directory": "packages/three-star-field"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./interaction": {
      "types": "./src/interaction.d.ts",
      "default": "./src/interaction.js"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@found-in-space/star-trees": "0.2.1-alpha.0"
  },
  "peerDependencies": {
    "three": "^0.170.0",
    "@found-in-space/touch-os": "0.4.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@found-in-space/touch-os": {
      "optional": true
    }
  },
  "devDependencies": {
    "@found-in-space/touch-os": "0.4.0-alpha.0"
  }
}
