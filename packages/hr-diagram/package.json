{
  "name": "@found-in-space/hr-diagram",
  "version": "0.2.0-alpha.0",
  "description": "Reusable HR diagram data, canvas, WebGL, and touch-os helpers for Found in Space star cells",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/skykit",
    "directory": "packages/hr-diagram"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./touch-os": {
      "types": "./src/touch-os.d.ts",
      "default": "./src/touch-os.js"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@found-in-space/star-trees": "0.2.0-alpha.0"
  },
  "peerDependencies": {
    "@found-in-space/touch-os": ">=0.2.0-dev.1 <1",
    "three": "^0.170.0"
  },
  "peerDependenciesMeta": {
    "@found-in-space/touch-os": {
      "optional": true
    }
  }
}
